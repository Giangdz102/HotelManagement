<Window x:Class="HotelManagement.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement"
        mc:Ignorable="d"
            Title="Report Statistic" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpStartDate" Width="150" Height="30"/>

                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <DatePicker x:Name="dpEndDate" Width="150" Height="30"/>

                <Button Content="Tạo Báo Cáo" Width="118" Height="30" Margin="20,0,0,0" Background="#4CAF50" Foreground="White" Click="BtnGenerateReport_Click" />
            </StackPanel>
        </Border>

        <ListView x:Name="LvReport" Grid.Row="1" Background="White" BorderBrush="#E0E0E0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Booking ID" DisplayMemberBinding="{Binding BookingReservationId}" Width="130"/>
                    <GridViewColumn Header="Booking Date" DisplayMemberBinding="{Binding BookingDate}" Width="150"/>
                    <GridViewColumn Header="Customer ID" DisplayMemberBinding="{Binding CustomerId}" Width="140"/>
                    <GridViewColumn Header="Total Price" DisplayMemberBinding="{Binding TotalPrice}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
