<Window x:Class="HotelManagement.CustomerDashboard"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Customer Dashboard" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Profile Section -->
        <GroupBox Header="Thông tin cá nhân (Profile)" Grid.Row="0" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Họ và tên:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="25" x:Name="txtFullName"/>

                <Label Grid.Row="1" Content="Số điện thoại:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="25" x:Name="txtTelephone"/>

                <Label Grid.Row="2" Content="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Height="25" x:Name="txtEmail" IsReadOnly="True" Background="#EEEEEE"/>

                <Label Grid.Row="3" Content="Ngày sinh:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Height="25" x:Name="txtBirthday"/>

                <Button Grid.Row="4" Grid.Column="1" Content="Cập nhật Profile" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0" Click="BtnUpdateProfile_Click"/>
            </Grid>
        </GroupBox>

        <!-- Booking History Section -->
        <GroupBox Header="Lịch sử đặt phòng (Booking History)" Grid.Row="1" Padding="10">
            <ListView x:Name="LvBookingHistory" Background="White" BorderBrush="#E0E0E0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Booking ID" DisplayMemberBinding="{Binding BookingReservationId}" Width="100"/>
                        <GridViewColumn Header="Booking Date" DisplayMemberBinding="{Binding BookingDate}" Width="150"/>
                        <GridViewColumn Header="Total Price" DisplayMemberBinding="{Binding TotalPrice}" Width="150"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding BookingStatus}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</Window>
