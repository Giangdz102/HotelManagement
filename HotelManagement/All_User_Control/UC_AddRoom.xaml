<UserControl x:Class="HotelManagement.All_User_Control.UC_AddRoom"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.All_User_Control"
                
        >
    <Grid  Loaded="UC_AddRoom_Loaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="593*" />
            <ColumnDefinition Width="348*" />
        </Grid.ColumnDefinitions>
        <Label Content="Thêm Phòng" HorizontalAlignment="Left" Margin="42,35,0,0" VerticalAlignment="Top" Height="38" Width="157" FontSize="18 pt" FontFamily="Century" FontWeight="Bold"/>
        <DataGrid ColumnWidth="*" x:Name="dataGridView" Margin="10,93,0,85" BorderThickness="1" BorderBrush="Black" CanUserAddRows="False"/>
        <Label Content="Số Phòng" HorizontalAlignment="Left" Margin="43,93,0,0" VerticalAlignment="Top" Height="40" Width="141" Foreground ="Black" FontFamily="Century Gothic" FontSize="11 pt" Grid.Column="1" FontWeight="Bold"/>
        <TextBox x:Name="txtRoomNo" HorizontalAlignment="Left" Margin="43,138,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="76" Width="487" FontSize="11 pt" Grid.Column="1" BorderBrush="Black"
         BorderThickness="2"/>
        <Label Content="Loại Phòng" FontWeight="Bold" HorizontalAlignment="Left" Margin="43,286,0,0" VerticalAlignment="Top" Height="40" Width="141" Foreground ="Black" FontFamily="Century Gothic" FontSize="11 pt" Grid.Column="1"/>
        <ComboBox x:Name="txtRoomType" Grid.Column="1" HorizontalAlignment="Left" Margin="43,331,0,0" VerticalAlignment="Top" Width="487" Height="29" FontSize="11 pt">
            <ComboBoxItem Background="White">Ac</ComboBoxItem>
            <ComboBoxItem Background="White">Non-Ac</ComboBoxItem>
        </ComboBox>
        <Label Content="Giá Tiền" FontWeight="Bold" HorizontalAlignment="Left" Margin="43,566,0,0" VerticalAlignment="Top" Height="40" Width="141" Foreground ="Black" FontFamily="Century Gothic" FontSize="11 pt" Grid.Column="1"/>
        <TextBox x:Name="txtPrice" HorizontalAlignment="Left" Margin="43,611,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="76" Width="487" FontSize="11 pt" Grid.Column="1" BorderBrush="Black"
         BorderThickness="2"/>
        <Label Content="Loại Giường" FontWeight="Bold" HorizontalAlignment="Left" Margin="43,440,0,0" VerticalAlignment="Top" Height="40" Width="141" Foreground ="Black" FontFamily="Century Gothic" FontSize="11 pt" Grid.Column="1"/>
        <ComboBox x:Name="txtBed" Grid.Column="1" HorizontalAlignment="Left" Margin="43,485,0,0" VerticalAlignment="Top" Width="487" Height="29" FontSize="11 pt">
            <ComboBoxItem Background="White">Single</ComboBoxItem>
            <ComboBoxItem Background="White">Double</ComboBoxItem>
            <ComboBoxItem Background="White">Triple</ComboBoxItem>
        </ComboBox>
        <Button x:Name="btnAddRoom" Grid.Column="1" Content="Thêm Phòng" HorizontalAlignment="Left" Margin="360,727,0,0" VerticalAlignment="Top" Height="45" Width="170" FontSize="14.667" FontWeight="Bold" Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="10" BorderThickness="1" BorderBrush="Black" Click="btnAddRoom_Click"/>

    </Grid>
</UserControl>
