<Window x:Class="HotelManagement.Dashboard"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement"
        mc:Ignorable="d"
        Title="Dashboard" Height="1600" Width="2560"
       WindowState="Maximized" Background="#FF8469FF">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Thêm Phòng"
                    x:Name="btnAddRoom"
                    FontSize="25"
                    Foreground="White"
                Height="120"
                Margin="10"
                    Background="#00A5CF"
                    Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="30"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Button Content="Đăng Ký Khách Hàng"
                    x:Name="btnCustomerRes"
                     FontSize="25"
                     Foreground="White"
                Height="120"
                Margin="10"
                Background="#00A5CF"
                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="30"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Button Content="Thanh Toán"
                    x:Name="btnCheckOut"
                     FontSize="25"
                     Foreground="White"
                Height="120"
                Margin="10"
                Background="#00A5CF"
                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="30"/>
        </StackPanel>

        <StackPanel Grid.Column="3">
            <Button Content="Chi Tiết Khách Hàng"
                    x:Name="btnCustomerDetails"
                     FontSize="25"
                     Foreground="White"
                Height="120"
                Margin="10"
                Background="#00A5CF"
                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="30"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
            <Button Content="Nhân Viên"
                    x:Name="btnEmployee"
                        FontSize="25"
                        Foreground="White"
                Height="120"
                Margin="10"
                Background="#00A5CF"
                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="30"/>
        </StackPanel>
    </Grid>
</Window>
